<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/accent" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="14dp" /></shape></item>
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/accent_deep" /><corners android:radius="14dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/option_bg" /><stroke android:width="1dp" android:color="@color/line" /><corners android:radius="14dp" /></shape></item>
</selector>

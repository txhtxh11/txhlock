<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focus" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_press" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- 方块选中时文字变深色：子 View 打开 duplicateParentState 后跟随父容器的 focused 状态 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/on_accent" />
    <item android:state_pressed="true" android:color="@color/on_accent" />
    <item android:color="@color/text_main" />
</selector>

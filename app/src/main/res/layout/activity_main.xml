<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="960dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="每日壁纸 · 家长设置"
                    android:textColor="@color/text_main"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:includeFontPadding="false"
                    android:text="v1.9.8"
                    android:textColor="@color/text_dim"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="监控开关" />

            <TextView
                android:id="@+id/btnEnable"
                style="@style/RowBtn"
                android:text="监控：已开启（点此停用）" />

            <TextView
                style="@style/Hint"
                android:text="关掉后不计时、不锁屏；家长设置仍要密码。" />

            
            <TextView
                style="@style/Label"
                android:text="长按菜单键进入设置（秒）" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnHoldMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvHoldSec"
                    style="@style/StepValue"
                    android:text="10" />

                <TextView
                    android:id="@+id/btnHoldPlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="壁纸界面按住菜单键这么久才进家长设置；前 8 秒不显示，最后 2 秒才倒计时（默认 10 秒）。" />

            <TextView style="@style/Label" android:text="单次连续观看（分钟，到点答题解锁）" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnSingleMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvSingle"
                    style="@style/StepValue"
                    android:text="20" />

                <TextView
                    android:id="@+id/btnSinglePlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="看满这个时长就弹锁屏；答对后重新计时。范围 5~120 分钟。" />

            <TextView style="@style/Label" android:text="每日累计上限（分钟，0=不限）" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnDailyMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvDaily"
                    style="@style/StepValue"
                    android:text="0" />

                <TextView
                    android:id="@+id/btnDailyPlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="长关机重置阈值（分钟，0=不限）" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnAwayMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvAway"
                    style="@style/StepValue"
                    android:text="30 分钟" />

                <TextView
                    android:id="@+id/btnAwayPlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="关机不超过这个时长：计时接着走、锁屏保留；超过：本次计时清零（今日已看不减）；过零点：全部清零。0=不限。" />

            <TextView style="@style/Label" android:text="连续答对题数（答对才解锁）" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnCorrMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvCorrect"
                    style="@style/StepValue"
                    android:text="3" />

                <TextView
                    android:id="@+id/btnCorrPlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="孩子年级" />

            <LinearLayout style="@style/Stepper">

                <TextView
                    android:id="@+id/btnLevelMinus"
                    style="@style/StepBtn"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvLevel"
                    style="@style/StepValue"
                    android:text="二年级" />

                <TextView
                    android:id="@+id/btnLevelPlus"
                    style="@style/StepBtn"
                    android:text="+" />
            </LinearLayout>

            <TextView
                style="@style/Hint"
                android:text="1~9 年级；只出该年级及以下的题，不超纲。" />

            <TextView style="@style/Label" android:text="教材版本（语文/数学/英语按版本出题）" />

            <LinearLayout
                android:id="@+id/editionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView style="@style/Label" android:text="启用题型（可多选）" />

            <LinearLayout
                android:id="@+id/typeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView style="@style/Label" android:text="题库" />

            <TextView
                android:id="@+id/tvQuizStatus"
                style="@style/Hint"
                android:text="未加载" />

            <TextView
                style="@style/Hint"
                android:text="想加自己的题：把 txt 文件拷到电视的 Download/txhlock 文件夹（U 盘或 SMB 都行），再点「重新加载题库」。一行一题：题目|答案|错误1;错误2;错误3" />

            <TextView
                android:id="@+id/btnExportQuiz"
                style="@style/RowBtn"
                android:text="导出内置题库（照着改）" />

            <TextView
                android:id="@+id/btnReloadQuiz"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="重新加载题库" />

            <TextView
                android:id="@+id/btnClearLocal"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="删除本地题库文件（只删本地，不动内置）" />

            <TextView style="@style/Label" android:text="局域网 SMB 题库同步（打开应用时自动更新）" />

            <TextView
                android:id="@+id/tvSmbStatus"
                style="@style/Hint"
                android:text="SMB 同步未开启" />

            <TextView
                android:id="@+id/btnSmbSetup"
                style="@style/RowBtn"
                android:text="SMB 同步设置" />

            <TextView
                android:id="@+id/btnSmbSyncNow"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="立即更新 SMB 题库" />

            <TextView style="@style/Label" android:text="家长密码" />

            <TextView
                android:id="@+id/btnChangePin"
                style="@style/RowBtn"
                android:text="修改家长密码（默认 1234）" />

            <TextView style="@style/Label" android:text="防绕过 / 锁屏方式" />

            <TextView
                android:id="@+id/btnBootLock"
                style="@style/RowBtn"
                android:text="开机先答题：开（点此关闭）" />

            <TextView
                android:id="@+id/btnOverlay"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="悬浮层：检查中…" />

            <TextView
                android:id="@+id/tvHomeStatus"
                style="@style/Hint"
                android:text="系统桌面：未做任何修改" />

            <TextView
                android:id="@+id/btnAcc"
                style="@style/RowBtn"
                android:text="去系统里打开无障碍（当前：未开启）" />

            <TextView
                android:id="@+id/tvAccStatus"
                style="@style/Hint"
                android:text="正在检测无障碍保活状态…" />

            <TextView
                android:id="@+id/tvAccState"
                style="@style/Hint"
                android:text="无障碍：正在检测…" />

            <TextView
                style="@style/Hint"
                android:text="更新/覆盖安装后，小米电视可能会自动关掉无障碍；更新完回来看到「未开启」，点上面的按钮重开一次即可。" />

            <TextView
                android:id="@+id/btnSysSettings"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="打开系统设置：自启动 / 权限" />

            <TextView
                android:id="@+id/btnHomeSetup"
                style="@style/RowBtn"
                android:layout_marginTop="10dp"
                android:text="还原并卸载（恢复小米桌面）" />

            <TextView style="@style/Label" android:text="帮助与诊断" />

            <TextView
                android:id="@+id/tvHelp"
                style="@style/Hint"
                android:text="正在读取状态…" />

            <TextView
                android:id="@+id/btnFixAcc"
                style="@style/RowBtn"
                android:text="去修复主页键拦截" />

            <TextView
                android:id="@+id/btnTestLock"
                style="@style/RowBtn"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_primary"
                android:text="立即锁定测试" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/gateLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
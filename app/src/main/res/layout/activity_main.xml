<?xml version="1.0" encoding="utf-8"?>
<!--
  家长设置主页 v2.0：一屏放完，不滚动。
  960x540dp 设计空间（1080p / 4K 电视都会按屏幕宽度自动等比放大）：
    头部 62dp + 三张数据卡 + 2x2 设置卡片 + 底部两个按钮
  所有卡片等宽等高，左右边距、卡片间距全应用统一。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp">

        <!-- 头部：标题 + 守护开关 + 版本号 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="答题锁屏守护"
                    android:textColor="@color/text_main"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="家长设置 · 方向键选择 · OK 确认"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="● 守护中"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:includeFontPadding="false"
                android:text="v2.0"
                android:textColor="@color/text_faint"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 三张数据卡：今日已看 / 单次时长 / 连对解锁 -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <!-- 2x2 设置卡片 -->
        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1.55"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/gridRow1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/gridRow2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 底部：帮助 / 立即锁定测试 -->
        <LinearLayout
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHelp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="帮助与诊断"
                android:textColor="@color/text_main"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnTestLock"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="立即锁定测试"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 弹层容器：详情页 / 确认框 -->
    <FrameLayout
        android:id="@+id/sheetLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 家长密码门禁 -->
    <FrameLayout
        android:id="@+id/gateLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>

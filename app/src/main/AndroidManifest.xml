<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kidslock">

    <!-- 开机自启：防重启绕过锁屏 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUICKBOOT_POWERON" />
    <!-- 悬浮层锁屏（v3.0）：盖在桌面之上，主页键切到桌面时也不会露出桌面 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务保活（长期计时，不声明 shortService 类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 局域网 SMB 访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 读取自定义题库：
         Android 10 及以下用 READ_EXTERNAL_STORAGE；
         Android 11+ 分区存储下读取 Download 目录的 txt 用 MANAGE_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 卸载本地题库：Android 10 及以下删除 /sdcard/Download 文件需要写权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_wallpaper"
        android:allowBackup="false"
        android:theme="@style/Theme.KidsLock"
        android:supportsRtl="false">

        <!-- 家长设置（只有壁纸界面长按菜单键进入） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 旧快捷方式兜底：点进来直接跳回壁纸 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 壁纸伪装入口：桌面显示「每日壁纸」 -->
        <activity
            android:name=".WallpaperActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.kidslock.wall"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KidsLock.Wallpaper" />

        <!-- 伪装入口：桌面显示「每日壁纸」 -->
        <activity-alias
            android:name=".LauncherWallpaper"
            android:targetActivity=".WallpaperActivity"
            android:exported="true"
            android:label="@string/name_wall"
            android:icon="@mipmap/ic_wallpaper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 全屏答题锁屏 -->
        <activity
            android:name=".LockScreenActivity"
            android:exported="false"
            android:taskAffinity="com.kidslock.lockscreen"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.KidsLock.Lock"
            android:noHistory="false" />

        <!-- 前台计时服务：长期运行，不声明 shortService 类型 -->
        <service
            android:name=".QuizService"
            android:exported="false" />

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 补拉 / 看门狗：对付"开机后被系统桌面盖住"和"进程被 ROM 杀掉" -->
        <receiver
            android:name=".KeeperReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kidslock.action.RETRY_LOCK" />
                <action android:name="com.kidslock.action.WATCHDOG" />
            </intent-filter>
        </receiver>

        <!-- 无障碍保活：小米电视会拦截第三方应用的 BOOT_COMPLETED，
             但系统会在开机时主动绑定"已启用的无障碍服务"，这条路径更可靠。 -->
        <service
            android:name=".BootAccessibility"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- 注意：本应用【不再】声明 CATEGORY_HOME，也不再接管系统桌面。
             原因：接管桌面会改写系统的"默认桌面"记录，卸载后未必能干净还原。
             现在锁屏靠"无障碍保活"把前台抢回来，对系统桌面零改动，
             卸载后小米电视桌面 100% 恢复原样。 -->
    </application>
</manifest>
